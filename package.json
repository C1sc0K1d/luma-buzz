{
  "name": "luma-buzz",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 4200",
    "predev:lan": "node scripts/show-lan-addresses.mjs",
    "dev:lan": "next dev --hostname 0.0.0.0 --port 4200",
    "start:lan": "npm run dev:lan",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 4200",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write src scripts tests docs README.md *.json *.mjs *.ts",
    "format:check": "prettier --check src scripts tests docs README.md *.json *.mjs *.ts"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "postcss": "^8.5.0",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.0",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
